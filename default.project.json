
{
  "name": "forgeGod",
  "tree": {
    "$className": "DataModel",

    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      },
      "Assets": {
        "$path": "src/assets"
      },
      "Design": {
        "$path": "src/Design.rbxm"
      }
    },

    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },

    "ServerStorage": {
      "$path": "src/serverStorage"
    },

    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },

    "StarterGui": {
  "$className": "StarterGui",
  "$ignoreUnknownInstances": true,
  "$path": "src/starterGui"
},

    "Lighting": {
      "$path": "src/lighting",
      "$properties": {
        "Ambient": [0.470588, 0.470588, 0.490196],
        "OutdoorAmbient": [0.588235, 0.588235, 0.588235],
        "Brightness": 3,
        "ClockTime": 14.5,
        "GeographicLatitude": 0,
        "ExposureCompensation": 0.15,
        "EnvironmentDiffuseScale": 0.6,
        "EnvironmentSpecularScale": 0.6,
        "ShadowSoftness": 1,
        "GlobalShadows": true,
        "ColorShift_Bottom": [0, 0, 0],
        "ColorShift_Top": [1, 0.960784, 0.882353],
        "FogColor": [0.752941, 0.752941, 0.752941],
        "FogStart": 0,
        "FogEnd": 100000,
        "LightingStyle": "Realistic",
        "PrioritizeLightingQuality": true
      }
    },

    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
